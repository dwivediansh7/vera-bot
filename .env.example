# Copy to .env (never commit .env). Everything is optional: with no LLM key Vera runs fully deterministic templates.
# Comments are on their own lines on purpose (docker --env-file does not strip inline comments).

# /v1/metadata
TEAM_NAME=Ansh Dwivedi
TEAM_MEMBERS=Ansh Dwivedi
CONTACT_EMAIL=dwivediansh0@gmail.com
SUBMITTED_AT=2026-09-26T00:00:00Z

# Optional LLM polish via any OpenAI-compatible endpoint. Free options: groq, gemini, openrouter.
# LLM_PROVIDER: groq | gemini | openrouter | openai
LLM_PROVIDER=groq
# Key may also be given as GROQ_API_KEY / GEMINI_API_KEY / OPENAI_API_KEY
LLM_API_KEY=
# Empty = provider default (groq: llama-3.3-70b-versatile, gemini: gemini-2.0-flash)
LLM_MODEL=
LLM_BASE_URL=
# polish | off
VERA_LLM_MODE=polish
# Outbound (tick) messages use the LLM only if on; default off = deterministic templates for outbound, LLM for replies
LLM_OUTBOUND=off
# Persisted LLM response cache (keeps outputs identical across restarts); empty disables
LLM_CACHE_PATH=
LLM_TIMEOUT_S=6
# Stay under the free tier's requests-per-minute cap
LLM_RPM=25

# Latency budgets in seconds (judge hard limit is 30)
TICK_BUDGET_S=12
REPLY_BUDGET_S=8

# 1 exposes /v1/debug/decisions (decision log); keep 0 in production
VERA_DEBUG=0
